# Rust build artifacts (prevents copying multi-GB host target directories into the Docker build context)
**/target
**/dist

# Local database volumes, logs & PIDs
data/
logs/
.pids/
*.surql
*.log

# Git & macOS metadata
.git/
.DS_Store

# Large documents / PDFs in the repository root & Showcase PDF folders (only Showcase/**/src/*.rs is needed for Rust compilation)
*.pdf
Showcase/**/documents
