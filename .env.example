# ==============================================================================
# 100% Rust RAG & GraphRAG Stack - Environment Configuration (.env)
# ==============================================================================

# --- 1. HARDWARE & MODEL PROFILE ---
# Compute mode:
# - "metal" -> Apple Silicon M1–M6 (SurrealDB & Orchestrator in Docker + native Metal GPU TEI servers)
# - "gpu"   -> NVIDIA CUDA GPU (All components in Docker with NVIDIA Container Runtime)
# - "cpu"   -> Pure CPU mode (All components in Docker)
COMPUTE_MODE=cpu

# Model preset:
# "high"  = BAAI/bge-m3 (1024d) + BAAI/bge-reranker-v2-m3 (Recommended for 16+ GB RAM or 6+ GB VRAM)
# "light" = BAAI/bge-base-en-v1.5 (768d) + BAAI/bge-reranker-base (For smaller servers with 8+ GB RAM)
MODEL_PRESET=high

# Explicit model identifiers & dimensions (matching the selected preset)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_FAST_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- 2. SURREALDB CONFIGURATION (Multi-Model: HNSW + BM25 + Graph) ---
SURREAL_USER=root
SURREAL_PASS=root_secret_password_change_me
SURREAL_NS=rag_namespace
SURREAL_DB=knowledge_base
SURREAL_PORT=8000
SURREAL_URL=http://surrealdb:8000

# --- 3. INFERENCE SERVICES (Hugging Face TEI - Rust) ---
TEI_EMBED_PORT=8081
TEI_RERANK_PORT=8082
TEI_RERANK_FAST_PORT=8083
TEI_EMBED_URL=http://tei-embed:80
TEI_RERANK_URL=http://tei-rerank:80
TEI_RERANK_FAST_URL=http://tei-rerank-fast:80

# --- 4. GENERIC LLM CONFIGURATION (Local, Remote GPU & Cloud) ---
# Supported providers:
# - "openai_compatible" -> Ollama, vLLM, llama.cpp, LM Studio, RunPod, OpenAI, OpenRouter, Google Gemini (OpenAI endpoint)
# - "ollama"            -> Native Ollama API (/api/chat)
# - "anthropic"         -> Anthropic Claude API (/v1/messages)
# - "gemini_native"     -> Google Gemini Native REST API (generateContent)
# - "none"              -> Retrieval- & indexing-only mode (no LLM calls made by the orchestrator)
LLM_PROVIDER=openai_compatible

# Examples for LLM_BASE_URL:
# - Ollama (local on host):      http://host.docker.internal:11434/v1
# - vLLM / llama.cpp (local):    http://host.docker.internal:8000/v1
# - RunPod vLLM Proxy:           https://YOUR-POD-ID-8000.proxy.runpod.net/v1
# - OpenAI (Cloud):              https://api.openai.com/v1
# - Google Gemini (OpenAI API):  https://generativelanguage.googleapis.com/v1beta/openai
# - Anthropic Claude:            https://api.anthropic.com/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Whether entities & graph edges should be extracted automatically via LLM during document ingestion
ENABLE_GRAPH_EXTRACTION=false

# --- 5. RUST RAG ORCHESTRATOR API ---
ORCHESTRATOR_PORT=8080
CHUNK_MAX_CHARS=1000
RETRIEVAL_TOP_K_CANDIDATES=15
RETRIEVAL_FINAL_TOP_N=4
